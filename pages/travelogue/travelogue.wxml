<view class="container">
  <view class="search-container">
    <van-search value="{{ searchValue }}" placeholder="搜索游记标题或作者" bind:change="onSearchChange" bind:search="onSearch" shape="round" background="#ffffff" />
  </view>
  <view class="card-list">
    <me-waterfall id="waterfall">
      <me-waterfall-item wx:for="{{cards}}" wx:key="id" bind:tap="toDetail" data-id="{{item.id}}" wx:if="{{item.status === 1 &&    item.isdeleted === false}}">
        <view class="waterfall-item">
          <image src="{{item.imglist[0]}}" mode="widthFix"/>
          <view class="item-content">
            <view class="item-title">{{item.title}}</view>
            <view class="item-desc">{{item.desc}}</view>
            <view class="item-footer">
              <view class="user-info">
                <image class="item-ava" src="{{item.avatar}}"></image>
                <text class="author">{{item.author}}</text>
              </view>
              <text class="views">👁 {{item.views}}</text>
            </view>
          </view>
        </view>
      </me-waterfall-item>
    </me-waterfall>
    
    <!-- 加载状态和加载更多提示 -->
    <view class="loading-container" wx:if="{{cards.length > 0}}">
      <view wx:if="{{loading}}" class="loading-text">
        <van-loading size="20px" color="#1989fa">加载中...</van-loading>
      </view>
      <view wx:elif="{{!hasMore}}" class="no-more-text">
        没有更多数据了
      </view>
      <view wx:elif="{{hasMore}}" class="load-more-text">
        上拉加载更多
      </view>
    </view>
  </view>
  <van-icon name="back-top" class="backtop" bindtap="backtop" />
</view>