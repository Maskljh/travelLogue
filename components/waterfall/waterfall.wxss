.waterfall-container {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 10px;
}

.scroll-view {
  display: flex;
  width: 100%;
}

.column {
  width: 48%;
}

.item {
  margin-bottom: 15px;
  background-color: #f0f0f0;
  padding: 10px;
  border-radius: 5px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}
