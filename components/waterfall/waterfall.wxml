<view class="waterfall-container">
  <view class="column">
    <view class="waterfall-item" wx:for="{{leftItems}}" wx:key="id" bind:tap="toDetail" data-id="{{item.id}}" wx:if="{{item.status === 1 && item.isdeleted === false}}">
      <view class="item-content">
        <image src="{{item.imglist[0]}}" mode="widthFix"/>
        <view class="item-content">
          <view class="item-title">{{item.title}}</view>
          <view class="item-desc">{{item.desc}}</view>
          <view class="item-footer">
            <view class="user-info">
              <image class="item-ava" src="{{item.avatar}}"></image>
              <text class="author">{{item.author}}</text>
            </view>
            <text class="views">👁 {{item.views}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="column">
    <view class="waterfall-item" wx:for="{{rightItems}}" wx:key="id" bind:tap="toDetail" data-id="{{item.id}}" wx:if="{{item.status === 1 && item.isdeleted === false}}">
      <view class="item-content">
        <image src="{{item.imglist[0]}}" mode="widthFix"/>
        <view class="item-content">
          <view class="item-title">{{item.title}}</view>
          <view class="item-desc">{{item.desc}}</view>
          <view class="item-footer">
            <view class="user-info">
              <image class="item-ava" src="{{item.avatar}}"></image>
              <text class="author">{{item.author}}</text>
            </view>
            <text class="views">👁 {{item.views}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
